ANTHROPIC_API_KEY=your-key-here

# Select the backend configured in config.py: gemini, anthropic, or ollama.
JUDGE_BACKEND=gemini

# Required when JUDGE_BACKEND=gemini.
GEMINI_API_KEY=your-gemini-key-here
GEMINI_MODEL=gemini-2.5-flash

# Ollama Cloud (optional — set JUDGE_BACKEND=ollama and OLLAMA_HOST in config.py)
OLLAMA_API_KEY=your-ollama-key-here
OLLAMA_HOST=
